<Window x:Class="MatrixBlack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MatrixBlack"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:BoolVisibilityConverter x:Key="Vis" />
        <local:BoolVisibilityConverter x:Key="VisInv" Invert="True" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChannelToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{Binding Brush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{Binding BrushMuted}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2A2A2A" BorderBrush="#111111" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open CSV" ToolTip="Ctrl+O" Click="Open_Click" />
                    <Button Content="Save CSV" ToolTip="Ctrl+S" Click="Save_Click" IsEnabled="{Binding CanSave}" />
                    <Button Content="Save Copy" ToolTip="Ctrl+Shift+S" Click="SaveCopy_Click" IsEnabled="{Binding HasSamples}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"
                               ToolTip="{Binding SourcePath}" />
                    <TextBlock Text="• Edited" Margin="8,2,0,0" Foreground="#FF9F0A" FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource Vis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#2A2A2A" BorderBrush="#111111" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryText}" FontFamily="Consolas" FontSize="12"
                           Foreground="#9A9A9A" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Channels}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChannelToggle}" IsChecked="{Binding IsVisible, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#1A1A1A" BorderBrush="#111111" BorderThickness="0,0,0,1" Padding="14,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#30D158" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Content="Undo" ToolTip="Ctrl+Z" Click="Undo_Click" IsEnabled="{Binding CanUndo}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionLabel}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FFD60A" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource Vis}}" />
                    <Button Content="Remove Window from CSV" ToolTip="Delete" Click="Remove_Click"
                            Background="#C62828" FontWeight="SemiBold"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}" />
                    <Button Content="Clear Selection" ToolTip="Esc" Click="Clear_Click"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}}" />
                    <TextBlock Text="Click or drag across 1-second vertical columns to select a window for removal"
                               FontSize="12" Foreground="#9A9A9A" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource VisInv}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#2A2A2A" BorderBrush="#111111" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Position:" Foreground="#9A9A9A" FontSize="12" VerticalAlignment="Center" />
                <Slider Width="260" Margin="8,0,8,0" Minimum="0" Maximum="{Binding MaxWindowStart}"
                        Value="{Binding WindowStartSeconds, Mode=TwoWay}" IsEnabled="{Binding CanScrub}"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding WindowStartSeconds, StringFormat={}{0:0.0}s}" FontFamily="Consolas"
                           FontSize="11" Width="52" VerticalAlignment="Center" />

                <TextBlock Text="Window:" Margin="18,0,8,0" Foreground="#9A9A9A" FontSize="12" VerticalAlignment="Center" />
                <ComboBox Width="120" ItemsSource="{Binding DurationChoices}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding CurrentDurationChoice, Mode=TwoWay}"
                          VerticalAlignment="Center" />

                <TextBlock Text="Scale:" Margin="18,0,8,0" Foreground="#9A9A9A" FontSize="12" VerticalAlignment="Center" />
                <ComboBox Width="110" ItemsSource="{Binding Scales}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding CurrentScale, Mode=TwoWay}"
                          VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid>
            <local:EegWaveformControl Store="{Binding}" />
            <Border Background="#E61A1A1A" CornerRadius="12" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="180" Height="8" Foreground="#64D2FF" Background="#333333" />
                    <TextBlock Margin="0,12,0,0" Text="Parsing 250 Hz EEG data..." HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
